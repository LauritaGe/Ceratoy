# API Keys — copiar este archivo a .env y rellenar
# cp api-keys.example.env .env

# Al menos una key de texto (obligatoria para --generate)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Imagen (opcional; sin ella se usa placeholder SVG)
REPLICATE_API_TOKEN=

# Proveedor de texto: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# Imagen con Replicate
IMAGE_PROVIDER=replicate
IMAGE_MODEL=black-forest-labs/flux-schnell
